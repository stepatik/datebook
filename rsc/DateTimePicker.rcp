/* Fallback time picker for Palm OS ROMs without SelectTime. */

FORM ID 2300 AT (0 0 160 160) NOFRAME USABLE MODAL
BEGIN
    TITLE "Set Time"

    LABEL "Start:" ID 2320 AT (8 39)
    POPUPTRIGGER "8 AM" ID 2301 AT (48 36 48 AUTO)
    LIST "12 AM" "1 AM" "2 AM" "3 AM" "4 AM" "5 AM" "6 AM" "7 AM"
         "8 AM" "9 AM" "10 AM" "11 AM" "12 PM" "1 PM" "2 PM" "3 PM"
         "4 PM" "5 PM" "6 PM" "7 PM" "8 PM" "9 PM" "10 PM" "11 PM"
         ID 2311 AT (48 36 48 12) VISIBLEITEMS 5 NONUSABLE
    POPUPLIST ID 2301 2311

    POPUPTRIGGER "00" ID 2302 AT (100 36 34 AUTO)
    LIST "00" "05" "10" "15" "20" "25" "30" "35" "40" "45" "50" "55"
         ID 2312 AT (100 36 34 12) VISIBLEITEMS 5 NONUSABLE
    POPUPLIST ID 2302 2312

    LABEL "End:" ID 2321 AT (8 66)
    POPUPTRIGGER "9 AM" ID 2303 AT (48 63 48 AUTO)
    LIST "12 AM" "1 AM" "2 AM" "3 AM" "4 AM" "5 AM" "6 AM" "7 AM"
         "8 AM" "9 AM" "10 AM" "11 AM" "12 PM" "1 PM" "2 PM" "3 PM"
         "4 PM" "5 PM" "6 PM" "7 PM" "8 PM" "9 PM" "10 PM" "11 PM"
         ID 2313 AT (48 63 48 12) VISIBLEITEMS 5 NONUSABLE
    POPUPLIST ID 2303 2313

    POPUPTRIGGER "00" ID 2304 AT (100 63 34 AUTO)
    LIST "00" "05" "10" "15" "20" "25" "30" "35" "40" "45" "50" "55"
         ID 2314 AT (100 63 34 12) VISIBLEITEMS 5 NONUSABLE
    POPUPLIST ID 2304 2314

    CHECKBOX "No Time" ID 2305 AT (8 91 60 12)
    BUTTON "OK" ID 2306 AT (22 119 48 14)
    BUTTON "Cancel" ID 2307 AT (83 119 55 14)
    GRAFFITISTATEINDICATOR AT (148 135)
END
