/* Details dialog rebuilt with PilRC for the Linux Palm OS 3.5 target. */

FORM ID 1300 AT (2 39 156 119) USABLE MODAL SAVEBEHIND DEFAULTBTNID 1316
BEGIN
    TITLE "Event Details"

    LABEL "Time:" ID 1302 AT (23 18)
    SELECTORTRIGGER "12:00 pm - 12:00 pm" ID 1303 AT (56 18 100 AUTO)

    LABEL "Date:" ID 1304 AT (23 34)
    SELECTORTRIGGER "DAY MM/DD/YY+7debug" ID 1305 AT (56 34 100 AUTO)

    LABEL "Alarm:" ID 1306 AT (18 50)
    CHECKBOX "" ID 1307 AT (53 49 14 14)
    FIELD ID 1308 AT (72 50 14 11) MAXCHARS 2 NONUSABLE
    POPUPTRIGGER "Minutes" ID 1310 AT (90 49 37 AUTO) NONUSABLE
    LIST "Minutes" "Hours" "Days" ID 1311 AT (90 49 37 12) VISIBLEITEMS 3 NONUSABLE
    POPUPLIST ID 1310 1311

    LABEL "Repeat:" ID 1312 AT (10 66)
    SELECTORTRIGGER "None" ID 1313 AT (56 66 80 AUTO)

    LABEL "Private:" ID 1314 AT (9 82)
    CHECKBOX "" ID 1315 AT (53 81 14 14)

    BUTTON "OK" ID 1316 AT (5 102 25 12)
    BUTTON "Cancel" ID 1317 AT (36 102 35 12)
    BUTTON "Delete..." ID 1318 AT (77 102 40 12)
    BUTTON "Note" ID 1319 AT (123 102 28 12)

    GRAFFITISTATEINDICATOR AT (148 135)
END
