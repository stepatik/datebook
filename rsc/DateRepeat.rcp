/* Repeat dialog rebuilt with PilRC for the Linux Palm OS 3.5 target. */

FORM ID 1400 AT (2 2 156 156) USABLE MODAL SAVEBEHIND DEFAULTBTNID 1430
BEGIN
    TITLE "Repeating Event"

    PUSHBUTTON "None" ID 1402 AT (7 20 26 11) GROUP 1
    PUSHBUTTON "Day" ID 1403 AT (34 20 23 11) GROUP 1
    PUSHBUTTON "Week" ID 1404 AT (58 20 30 11) GROUP 1
    PUSHBUTTON "Month" ID 1405 AT (89 20 32 11) GROUP 1
    PUSHBUTTON "Year" ID 1406 AT (122 20 25 11) GROUP 1

    LABEL "Every:" ID 1407 AT (24 38) NONUSABLE
    FIELD ID 1408 AT (60 38 17 11) MAXCHARS 2 NONUSABLE
    LABEL "Day(s)" ID 1409 AT (83 38) NONUSABLE
    LABEL "Week(s)" ID 1410 AT (83 38) NONUSABLE
    LABEL "Month(s)" ID 1411 AT (83 38) NONUSABLE
    LABEL "Year(s)" ID 1412 AT (83 38) NONUSABLE
    LABEL "Choose a repeat interval." ID 1429 AT (7 38) NONUSABLE

    LABEL "End on:" ID 1413 AT (21 55) NONUSABLE
    POPUPTRIGGER "**19 bytes**........" ID 1415 AT (60 55 70 AUTO) NONUSABLE
    LIST "No End Date" "Choose Date..." ID 1416 AT (60 58 70 70) VISIBLEITEMS 2 NONUSABLE
    POPUPLIST ID 1415 1416

    LABEL "Repeat on:" ID 1417 AT (5 72) NONUSABLE
    PUSHBUTTON "S" ID 1418 AT (63 72 10 12) NONUSABLE
    PUSHBUTTON "M" ID 1419 AT (74 72 10 12) NONUSABLE
    PUSHBUTTON "T" ID 1420 AT (85 72 10 12) NONUSABLE
    PUSHBUTTON "W" ID 1421 AT (96 72 10 12) NONUSABLE
    PUSHBUTTON "T" ID 1422 AT (107 72 10 12) NONUSABLE
    PUSHBUTTON "F" ID 1423 AT (118 72 10 12) NONUSABLE
    PUSHBUTTON "S" ID 1424 AT (129 72 10 12) NONUSABLE

    LABEL "Repeat by:" ID 1425 AT (5 72) NONUSABLE
    PUSHBUTTON "Day" ID 1426 AT (63 72 40 12) GROUP 2 NONUSABLE
    PUSHBUTTON "Date" ID 1427 AT (104 72 40 12) GROUP 2 NONUSABLE

    FIELD ID 1428 AT (10 100 136 22)

    BUTTON "OK" ID 1430 AT (4 140 25 12)
    BUTTON "Cancel" ID 1431 AT (35 140 36 12)

    GRAFFITISTATEINDICATOR AT (148 135)
END
